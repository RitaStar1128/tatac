<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tatac.syncnode</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/tatac-sync-node</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/tatac-sync-node.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tatac-sync-node.log</string>
</dict>
</plist>
